# =========================================================================================
# ENV TEMPLATE - DIEN TU HIEU
# Copy to .env on the server, then fill real secrets there.
# Never commit the real .env file.
# =========================================================================================

# === APP ===
APP_DEBUG=false
CRON_SECRET=

# === DATABASE ===
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# Legacy aliases used by older scripts.
DB_USER_BAOCAO=
DB_PASS_BAOCAO=
DB_USER_SHIPPER=
DB_PASS_SHIPPER=

# === TELEGRAM BOT TOKENS ===
BOT_WORKER_TOKEN=
BOT_REPORT_TOKEN=

# Numeric group/user chat ids are recommended.
WORKER_CHAT_ID=
BOSS_CHAT_ID=
BOSS_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# === AI / PAYMENT ===
GEMINI_API_KEY=
SEPAY_API_KEY=

# === ADMIN ===
# Prefer ADMIN_PASS_HASH generated by password_hash().
ADMIN_PASS=
ADMIN_PASS_HASH=

# === BANK / VIETQR ===
VNB_ACC=
VNB_BIN=ICB
VNB_HOLDER=
